    { "name": "ChargeForm", "file": "frontend/src/components/OperationView.tsx", "summary": "ground-2 14px panel, 4-col fields, boost checkbox, live quote, primary Reservar y activar (lucide Zap)." },
    { "name": "SessionStrip", "file": "frontend/src/components/OperationView.tsx", "summary": "Power / energy / battery / session figures at 26px narrow, 6px line-colour meter, quiet stop button." },
    { "name": "FailureNote", "file": "frontend/src/components/OperationView.tsx", "summary": "bad-wash note with TriangleAlert, failed step and code in bold." },
