  "icons": { "library": "lucide-react", "used": ["TrainFront", "Check", "X", "Zap", "Square", "TriangleAlert", "RotateCcw", "KeyRound", "Plus"] },
  "dos": [
    "Drive every identity surface from --line, set once from config.ts LINE.",
    "Draw any SAGA with the line grammar (large, mini, or vertical timeline).",
    "Use Archivo semi-condensed and heavy weights for nameplates and figures; keep tabular numerals.",
    "Separate with hairlines and ground-2 panels on a white ground.",
    "Spanish copy; full aria-label on diagrams."
  ],
  "donts": [
    "No KPI card grids, drop-shadowed cards, gradients or glassmorphism.",
    "No green for completed stations; no red as accent.",
    "No second typeface or monospace.",
    "No hard-coded environment colours in components.",
    "No filled coloured status pills in tables.",
    "Never hide a compensation that ran."
  ]
