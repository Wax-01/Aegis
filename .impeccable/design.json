  },
  "semantics": {
    "states": {
      "connector": { "AVAILABLE": "ok", "RESERVED": "run", "CHARGING": "line (blinking)", "FAULTED": "bad", "OFFLINE": "ink-4" },
      "stop": { "pending": "white + rule border", "current": "run border + pulse", "done": "line fill + check", "failed": "bad fill + X" },
      "returnStop": { "pending": "white + bad border", "done": "bad fill + check", "failed": "ink fill + bad border + X" },
      "sagaTone": {
        "STARTED": "run", "CONNECTOR_RESERVED": "run", "PAYMENT_CAPTURED": "run",
        "COMPLETED": "ok", "COMPENSATING": "warn (bad-ink, blinking)",
        "COMPENSATED": "bad", "FAILED": "bad", "COMPENSATION_FAILED": "bad"
      }
    },
    "rules": [
      "Red is only for the return branch and failures.",
      "Amber means in motion, never warning; warnings use bad-ink.",
      "Green means free / healthy; a completed station uses the line colour.",
      "Environment identity always flows from --line."
    ]
  },
  "components": [
