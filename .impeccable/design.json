    { "name": "SagaStatusLabel", "file": "frontend/src/components/SagaStatus.tsx", "summary": "Dot + coloured text, tones ok/run/warn/bad." },
    { "name": "TransactionsView", "file": "frontend/src/components/TransactionsView.tsx", "summary": "Filter chips, trip table, sticky detail with facts, LineDiagram replay, recovery banner, vertical timeline (red spine for compensations), wallet movements." },
    { "name": "FlagsView", "file": "frontend/src/components/FlagsView.tsx", "summary": "Flag x environment matrix with roundel heads, switch for connected env, solid or ghost ON/OFF pills elsewhere, policy divergence in red ink, amber admin-token form." },
    { "name": "HealthView", "file": "frontend/src/components/HealthView.tsx", "summary": "Services as stations on a 10px line bar (vertical on mobile), wallets with large balances, environment facts." }
